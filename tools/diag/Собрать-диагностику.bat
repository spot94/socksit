@echo off
chcp 65001 >nul
title Диагностика SocksIt
cd /d "%~dp0"

echo.
echo   ============================================================
echo    Сбор диагностики SocksIt
echo   ============================================================
echo.
echo   Что произойдёт:
echo     1. Скрипт запросит права администратора - согласитесь.
echo     2. Соберёт настройки, состояние сети и проверит прокси.
echo     3. Попросит на 45 секунд открыть приложение (ChatGPT или
echo        Claude) и попробовать отправить сообщение.
echo     4. Сохранит один текстовый файл рядом с этим батником.
echo.
echo   Всё занимает около двух минут. Отправьте полученный файл тому,
echo   кто попросил диагностику. Пароли в файл не попадают.
echo.
pause

powershell -NoProfile -ExecutionPolicy Bypass -File "Collect-SocksItDiag.ps1"
if errorlevel 1 (
  echo.
  echo   Не удалось запустить скрипт сбора.
  echo   Пришлите скриншот этого окна.
  echo.
  pause
)
