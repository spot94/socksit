# Normalize text to LF in the repo; let Git handle checkout conversion.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.exe   binary
*.dll   binary
*.syso  binary
*.ico   binary
*.zip   binary

# Windows scripts, and one of them is handed to end users as a file to double-
# click: cmd.exe mishandles multi-line parenthesised blocks with LF endings.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
